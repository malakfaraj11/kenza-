# Base de données PostgreSQL
DATABASE_URL=postgresql://kenza:kenzapassword@localhost:5432/kenzadb
POSTGRES_USER=kenza
POSTGRES_PASSWORD=kenzapassword
POSTGRES_DB=kenzadb

# Port serveur
PORT=3005

# Configuration LLM Principale (Compatible OpenAI / Endpoint Numeos)
OPENAI_API_KEY=votre_cle_api_ici
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Configuration LLM Fallback / Backup (Haute Disponibilité)
OPENAI_API_KEY_BACKUP=votre_deuxieme_cle_ici
OPENAI_BASE_URL_BACKUP=https://api.openai.com/v1
LLM_MODEL_BACKUP=gpt-4o-mini

# Configuration Alternative Google Gemini (Optionnel)
GEMINI_API_KEY=votre_cle_gemini_ici

# Configuration WhatsApp via Evolution API (Baileys / Connexion par QR Code)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=votre_evolution_api_key_ici
EVOLUTION_INSTANCE_NAME=kenza-session
